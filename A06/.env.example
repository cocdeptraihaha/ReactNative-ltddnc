# Copy this file to `.env` in the same folder (A06) and adjust.
# Do not commit `.env` (it is gitignored). Restart Metro after changes.

# Production (default in code)
# EXPO_PUBLIC_API_BASE=https://kebook.apn.leapcell.app/api/v1

# Backend on the same computer as Metro (simulator / web):
# EXPO_PUBLIC_API_BASE=http://localhost:8000/api/v1

# Physical phone + backend on your PC: use your PC LAN IP (same Wi‑Fi):
# EXPO_PUBLIC_API_BASE=http://192.168.1.10:8000/api/v1
